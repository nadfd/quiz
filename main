let current = 0;
let score = 0;
let answered = false;
const results = new Array(QUESTIONS.length).fill(null); // null | 'correct' | 'wrong'

const lightsEl = document.getElementById('lights');
const qnumEl = document.getElementById('qnum');
const questionEl = document.getElementById('questionText');
const optionsEl = document.getElementById('options');
const feedbackEl = document.getElementById('feedback');
const verdictEl = document.getElementById('verdict');
const explanationEl = document.getElementById('explanation');
const nextBtn = document.getElementById('nextBtn');
const quizBody = document.getElementById('quizBody');
const resultsEl = document.getElementById('results');

function buildLights(){
  lightsEl.innerHTML = '';
  QUESTIONS.forEach((_, i) => {
    const b = document.createElement('div');
    b.className = 'bulb';
    b.id = 'bulb-' + i;
    lightsEl.appendChild(b);
  });
  updateLights();
}

function updateLights(){
  QUESTIONS.forEach((_, i) => {
    const b = document.getElementById('bulb-' + i);
    b.classList.remove('lit','done-correct','done-wrong');
    if(results[i] === 'correct') b.classList.add('done-correct');
    else if(results[i] === 'wrong') b.classList.add('done-wrong');
    else if(i === current) b.classList.add('lit');
  });
}

const LETTERS = ['ก','ข','ค','ง'];

function renderQuestion(){
  answered = false;
  const item = QUESTIONS[current];
  qnumEl.textContent = 'ข้อที่ ' + (current+1) + ' / ' + QUESTIONS.length;
  questionEl.textContent = item.q;
  optionsEl.innerHTML = '';
  feedbackEl.classList.remove('show','correct','wrong');
  nextBtn.classList.remove('show');
  updateLights();

  item.options.forEach((opt, idx) => {
    const btn = document.createElement('button');
    btn.className = 'option';
    btn.innerHTML = '<span class="letter">' + LETTERS[idx] + '</span><span>' + opt + '</span>';
    btn.addEventListener('click', () => selectAnswer(idx, btn));
    optionsEl.appendChild(btn);
  });
}

function selectAnswer(idx, btn){
  if(answered) return;
  answered = true;
  const item = QUESTIONS[current];
  const allBtns = optionsEl.querySelectorAll('.option');
  allBtns.forEach(b => b.disabled = true);

  const isCorrect = idx === item.correct;
  if(isCorrect){
    btn.classList.add('correct');
    score++;
    results[current] = 'correct';
    verdictEl.textContent = 'ถูกต้อง!';
    feedbackEl.classList.add('correct');
  } else {
    btn.classList.add('wrong');
    allBtns[item.correct].classList.add('correct');
    results[current] = 'wrong';
    verdictEl.textContent = 'ยังไม่ถูก';
    feedbackEl.classList.add('wrong');
  }
  allBtns.forEach((b, i) => { if(i !== idx && i !== item.correct) b.classList.add('faded'); });

  explanationEl.textContent = item.explain;
  feedbackEl.classList.add('show');
  nextBtn.classList.add('show');
  nextBtn.textContent = (current === QUESTIONS.length - 1) ? 'ดูผลคะแนน' : 'ข้อต่อไป';
  updateLights();
}

nextBtn.addEventListener('click', () => {
  if(current < QUESTIONS.length - 1){
    current++;
    renderQuestion();
  } else {
    showResults();
  }
});

function showResults(){
  quizBody.classList.add('hide');
  resultsEl.classList.add('show');
  const pct = Math.round((score / QUESTIONS.length) * 100);
  document.getElementById('scoreRing').style.setProperty('--pct', pct);
  document.getElementById('scoreNum').textContent = score;

  let title, moral;
  if(score >= 9){
    title = 'ยอดเยี่ยม สมกับผู้ชมชั้นเซียน';
    moral = 'คุณจำเนื้อเรื่องและข้อคิดของ เห็นแก่ลูก ได้แม่นมาก ทั้งความเห็นแก่ตัวของนายล้ำในตอนต้น จนถึงการสำนึกผิดและให้อภัยกันในตอนจบ ซึ่งเป็นแก่นสำคัญของเรื่อง';
  } else if(score >= 6){
    title = 'ทำได้ดี เกือบครบองก์';
    moral = 'พอจับใจความเรื่องได้ดี ลองย้อนอ่านช่วงที่พระยาภักดีนฤนาถเปลี่ยนใจเรื่องการแต่งงาน และบทบาทของยายเพี้ยนอีกครั้ง จะช่วยให้เข้าใจปมเรื่องชัดขึ้น';
  } else {
    title = 'ยังต้องอ่านเนื้อเรื่องอีกรอบ';
    moral = 'ลองกลับไปอ่านเรื่องย่อ เห็นแก่ลูก อีกครั้ง โดยเฉพาะที่มา ตัวละครหลัก และเหตุการณ์สำคัญที่นำไปสู่การสำนึกผิดของนายล้ำ แล้วมาลองทำแบบทดสอบใหม่';
  }
  document.getElementById('resultTitle').textContent = title;
  document.getElementById('resultMoral').textContent = moral;
}

document.getElementById('retryBtn').addEventListener('click', () => {
  current = 0; score = 0; answered = false;
  results.fill(null);
  quizBody.classList.remove('hide');
  resultsEl.classList.remove('show');
  renderQuestion();
});

buildLights();
renderQuestion();
</script>
</body>
</html>
